{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Warsaw",
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "gitleaks image used via `docker run` in the CI workflow",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/gitleaks\\.yml$/"],
      "matchStrings": ["(?<depName>ghcr\\.io/gitleaks/gitleaks):(?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "linuxserver.io tags look like 6.4.4.10685-ls327, v1.6.2-ls372 or 12.4ubu2604-ls59; the -lsNNN suffix is the image rebuild number",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))?(?<compatibility>ubu\\d+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Profilarr v2 supports only Radarr v5 and v6; lift this once Radarr v7 is supported",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/radarr"],
      "allowedVersions": "<7"
    },
    {
      "description": "linuxserver reset the Sonarr build counter: 4.0.20.3014-ls3xx are OLDER builds than -ls1..-ls5; drop once Sonarr moves past 4.0.20.3014",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/sonarr"],
      "allowedVersions": "!/^4\\.0\\.20\\.3014-ls3\\d{2}$/"
    },
    {
      "description": "Profilarr and its parser must run the same tag",
      "matchPackageNames": ["ghcr.io/dictionarry-hub/profilarr", "ghcr.io/dictionarry-hub/profilarr-parser"],
      "groupName": "profilarr"
    },
    {
      "description": "Keep the pre-commit hook and the CI scan on the same gitleaks version",
      "matchPackageNames": ["gitleaks/gitleaks", "ghcr.io/gitleaks/gitleaks"],
      "groupName": "gitleaks"
    }
  ]
}
